# PROPOSED, NOT ACTIVE.
#
# GitHub only runs .yml and .yaml files in this folder, so this file does
# nothing until it is renamed. Today GitHub Pages publishes the main branch
# as it stands, which serves every tracked file (tests, fixtures and docs
# included) whether or not the tests pass.
#
# Once enabled, this workflow publishes only what the quiz loads (index.html,
# data.js, favicon.svg and images/), and only after npm test passes.
#
# Enabling it is a separate, manual step:
#   1. git mv .github/workflows/deploy.yml.proposed .github/workflows/deploy.yml
#      and merge that to main.
#   2. In the repository settings, Pages > Build and deployment > Source:
#      change "Deploy from a branch" to "GitHub Actions".
#   3. Watch the first run, then check the live site and one recorded seed
#      link from tests/fixtures/seed-urls.json.
# To roll back, set Source back to "Deploy from a branch" (main, root).

name: deploy

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  test:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - run: npm ci
      - run: npm test

  build:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Assemble the site from the files the page loads
        run: |
          mkdir _site
          cp index.html data.js favicon.svg _site/
          cp -R images _site/images
      - uses: actions/configure-pages@v5
      - uses: actions/upload-pages-artifact@v3
        with:
          path: _site

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
